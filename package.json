{
    "name": "asset-generator",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=26"
    },
    "packageManager": "pnpm@11.9.0",
    "scripts": {
        "typecheck": "tsc --noEmit",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:mutation": "stryker run",
        "test:mutation:full": "stryker run --force",
        "deps:validate": "depcruise src --output-type err",
        "deps:graph": "mkdir -p docs && depcruise src --include-only '^src' --output-type dot | dot -T svg > docs/dependency-graph.svg",
        "audit": "pnpm audit --prod --audit-level=high",
        "quality": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:coverage && pnpm deps:validate && pnpm run audit && pnpm test:mutation",
        "render": "tsx src/services/render/cli.ts",
        "dev": "next dev",
        "build": "next build",
        "start": "next start"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@stryker-mutator/core": "^9.6.1",
        "@stryker-mutator/typescript-checker": "^9.6.1",
        "@stryker-mutator/vitest-runner": "^9.6.1",
        "@tailwindcss/postcss": "^4.3.2",
        "@types/node": "26.1.1",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitest/coverage-v8": "^4.1.10",
        "dependency-cruiser": "^18.1.0",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-boundaries": "^7.0.2",
        "eslint-plugin-no-relative-import-paths": "^1.6.1",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-security": "^4.0.1",
        "fast-check": "^4.9.0",
        "globals": "^17.7.0",
        "happy-dom": "^20.10.6",
        "prettier": "^3.9.5",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "tailwindcss": "^4.3.2",
        "tsx": "^4.23.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.64.0",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "next": "^16.2.10",
        "puppeteer": "^25.3.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "sharp": "^0.35.3"
    }
}
